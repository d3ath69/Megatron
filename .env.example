# Copy to `.env` and edit. All variables have sane defaults for a fresh Docker or bare-metal install.
# The main megatron code reads these via os.environ.get(); docker-compose.yml passes them through.

# ─── LLM / Ollama ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
MODEL_NAME=hf.co/empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF:Q4_K_M
MODEL_TEMPERATURE=0.5
MODEL_THINK=false
OLLAMA_TIMEOUT=600
MEGATRON_MAX_LOOPS=6

# Alternative model (uncomment to override — smaller/older/safer default):
# MODEL_NAME=qwen2.5:7b-instruct
# MODEL_TEMPERATURE=0.1

# ─── MariaDB ──────────────────────────────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_USER=megatron
DB_PASSWORD=change-me-for-production
DB_NAME=megatron

# ─── HTTP auth passthrough (v0.6.0+) ──────────────────────────────────────────
# For scanning apps behind login — threaded through httpx / nuclei / katana /
# feroxbuster / dalfox / curl (in flag_hunt).
# AUTH_COOKIE=sessionid=abc123; csrftoken=xyz789
# AUTH_HEADER=Authorization: Bearer eyJhbGciOiJIUzI1NiJ9...

# ─── NVD API (v0.5.0+) ────────────────────────────────────────────────────────
# Optional — get a free key at https://nvd.nist.gov/developers/request-an-api-key
# Without it: 5 req/30s. With it: 50 req/30s.
# NVD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
