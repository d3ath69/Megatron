# Copy to `.env` and edit. All variables have sane defaults for a fresh Docker or bare-metal install.
# The main megatron code reads these via os.environ.get(); docker-compose.yml passes them through.

# ─── LLM / Ollama ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
MODEL_NAME=hf.co/empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF:Q4_K_M
MODEL_TEMPERATURE=0.5
MODEL_THINK=false
OLLAMA_TIMEOUT=600
MEGATRON_MAX_LOOPS=6

# v0.8.0: browser-loop planning model — defaults to MODEL_NAME. Set to a bigger
# model if you have the VRAM for it (e.g., 27B on P40) and want higher-quality
# CSS selector picks + fewer hallucinated actions.
# PLANNING_MODEL=hf.co/OBLITERATUS/Qwen3.8-27B-OBLITERATED:Q4_K_M

# v0.8.0: browser exploit action ceiling (default 15). Lower for faster scans,
# higher for tougher chained-flow challenges.
MEGATRON_BROWSER_MAX_ACTIONS=15

# v0.9.0: multi-shot ensemble — retry browser exploit with N different prompt
# angles per finding (default: 2). Each angle = fresh session + different vuln
# focus (default / lfi-first / sqli-first / idor-first / ssti-first / recon-again).
# Total scan time scales roughly linearly with this value.
MEGATRON_BROWSER_ANGLES=2

# Alternative model (uncomment to override — smaller/older/safer default):
# MODEL_NAME=qwen2.5:7b-instruct
# MODEL_TEMPERATURE=0.1

# ─── MariaDB ──────────────────────────────────────────────────────────────────
DB_HOST=mariadb
DB_PORT=3306
DB_USER=megatron
DB_PASSWORD=change-me-for-production
DB_NAME=megatron

# ─── HTTP auth passthrough (v0.6.0+) ──────────────────────────────────────────
# For scanning apps behind login — threaded through httpx / nuclei / katana /
# feroxbuster / dalfox / curl (in flag_hunt).
# AUTH_COOKIE=sessionid=abc123; csrftoken=xyz789
# AUTH_HEADER=Authorization: Bearer eyJhbGciOiJIUzI1NiJ9...

# v0.8.0: auth-bootstrap credentials — used by browser_agent.bootstrap_auth() to
# auto-register + login before the exploit loop starts. Successful login exports
# cookies back to AUTH_COOKIE (above), so downstream CLI tools inherit the session.
MEGATRON_BOOTSTRAP_USER=megatron_test_user
MEGATRON_BOOTSTRAP_PASS=M3g4tr0n!Test123
MEGATRON_BOOTSTRAP_EMAIL=megatron@example.test

# ─── NVD API (v0.5.0+) ────────────────────────────────────────────────────────
# Optional — get a free key at https://nvd.nist.gov/developers/request-an-api-key
# Without it: 5 req/30s. With it: 50 req/30s.
# NVD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
